# Copy to .env and fill in private values. Never commit .env.
#
# 部署提醒：本文件只是模板。系统**不会**自动识别服务器上的数据库——
# 若 .env 缺失，DB_HOST 等会退回下面注释掉的默认值（127.0.0.1 / root / 123456 /
# sales_data）并连不上库。生产环境请用系统环境变量或 systemd EnvironmentFile 配置。
# 注意：系统环境变量优先级**高于**本文件（python-dotenv override=False，已实测）。
# 详见 docs/部署与配置.md。

# 本地开发实际使用的远程库地址（仅作示例，请按自己环境填写）
# DB_HOST=47.114.36.52
# DB_PORT=3306
# DB_USER=your_db_user
# DB_PASS=your_db_password
# DB_NAME=东南亚运营数据

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_database

# 必须 ≥32 位随机串，否则后端拒绝启动。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 上线后不要更换，否则已签发的 JWT 全部失效。
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=43200
HOST=127.0.0.1
PORT=8000

# 登录失败限流：IP 维度开关，默认 false（停用）。
# 公司共用办公网出口 IP 时，IP 阈值会误伤正常用户，故默认停用。
# 账号维度（5 次/300 秒/锁 900 秒）始终生效，无需配置。
# 仅在确认部署环境每个用户有独立出口 IP、且需要防范批量枚举账号时才设为 true。
LOGIN_IP_LIMIT_ENABLED=false

# 数据库连接池。500 人规模建议上调 POOL_SIZE。
POOL_SIZE=10
MAX_OVERFLOW=20
