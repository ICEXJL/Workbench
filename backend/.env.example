# Copy to .env and fill in private values. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_database
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=43200
HOST=127.0.0.1
PORT=8000

# 登录失败限流：IP 维度开关，默认 false（停用）。
# 公司共用办公网出口 IP 时，IP 阈值会误伤正常用户，故默认停用。
# 账号维度（5 次/300 秒/锁 900 秒）始终生效，无需配置。
# 仅在确认部署环境每个用户有独立出口 IP、且需要防范批量枚举账号时才设为 true。
LOGIN_IP_LIMIT_ENABLED=false

# 数据库连接池。500 人规模建议上调 POOL_SIZE。
POOL_SIZE=10
MAX_OVERFLOW=20
